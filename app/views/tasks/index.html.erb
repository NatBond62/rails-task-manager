
<div class="m-5 p-5">
  <h1>My tasks</h1>
  <ul class="list-group">
    <% @tasks.each do |task| %>
    <li class="list-group-item">
      <%= check_box_tag :completed, 1, task.completed, disabled: true %>
      <%= link_to task.title, task_path(task), class:"text-decoration-none" %>
      <%= link_to "🗑️", task_path(task), data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}, class:"text-decoration-none"%>
    </li>
    <% end %>
  </ul>
  <hr class="border border-dark-subtle border-1">
  <div class="mt-2">
  <%= link_to new_task_path, class:"text-decoration-none" do %>
    <i class="fa-solid fa-plus"></i> Add a new task
  <% end %>
  </div>
</div>
