<div class="m-5 p-5">
  <h2>Edit task</h2>
  <div>
    <%= form_with model: @task do |f| %>
      <div class="form-group mt-1"
        <%= f.label :title %>
        <%= f.text_field :title, class: "form-control" %>
      </div>
      <div class="form-group mt-1">
        <%= f.label :details %>
        <%= f.text_field :details, class: "form-control" %>
      </div>
      <div class="form-check mt-1">
      <%= f.label :completed %>
      <%= f.check_box :completed, class:"form-check-input"  %>
      </div>
      <%= f.submit class:"btn btn-primary mt-1" %>
    <% end %>
  </div>
    <hr class="border border-dark-subtle border-1">
    <%= link_to tasks_path, class:"text-decoration-none" do %>
      <i class="fa-solid fa-rotate-left"></i> Back to list
    <% end %>
</div>
